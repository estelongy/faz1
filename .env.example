# ═══════════════════════════════════════════════════════════════════════
# ESTELONGY — Ortam Değişkenleri Şablonu
# ═══════════════════════════════════════════════════════════════════════
#
# KULLANIM:
#   1) Bu dosyayı .env.local olarak kopyala (.env.local gitignore'lı)
#      Windows: copy .env.example .env.local
#      Mac/Linux: cp .env.example .env.local
#
#   2) Production değerlerini al:
#      vercel env pull .env.local --environment=production
#      (Vercel CLI hassas değerleri şifreli verir, sadece kendi ENV
#       erişimi olan kişi açabilir)
#
#   3) Lokal geliştirmede her değeri elle gir:
#      Tüm gizli değerler 1Password / Bitwarden vault'unda olmalı
#
# ⚠ ASLA gerçek değerleri bu dosyaya yazmayın — sadece şablon!
# ═══════════════════════════════════════════════════════════════════════

# ── 1) Supabase (zorunlu) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://dcmnxmqzimrgmholktid.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public_anon_key>
SUPABASE_SERVICE_ROLE_KEY=<GIZLI_service_role_key>

# ── 2) Stripe ────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<...>
STRIPE_SECRET_KEY=sk_test_<GIZLI>
STRIPE_WEBHOOK_SECRET=whsec_<GIZLI>

# ── 3) Postmark e-posta ──────────────────────────────────────────────
POSTMARK_API_TOKEN=<GIZLI_postmark_server_token>
FROM_EMAIL=noreply@estelongy.com

# ── 4) Netgsm SMS ────────────────────────────────────────────────────
NETGSM_USERCODE=<usercode>
NETGSM_PASSWORD=<GIZLI_netgsm_password>
NETGSM_MSGHEADER=ESTELONGY

# ── 5) Upstash Redis (rate limit + OTP cache) ────────────────────────
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<GIZLI_token>

# ── 6) OpenAI (analiz endpoint) ──────────────────────────────────────
OPENAI_API_KEY=sk-proj-<GIZLI>

# ── 7) Sentry hata izleme ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ORG=estelongy
SENTRY_PROJECT=estelongy

# ── 8) Cron secret ───────────────────────────────────────────────────
CRON_SECRET=<rastgele_32_char_string>

# ── 9) Cloudflare Stream (akademi videoları) ─────────────────────────
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=<customer_code>
CLOUDFLARE_ACCOUNT_ID=<account_id>
CLOUDFLARE_STREAM_TOKEN=<GIZLI_api_token>

# ── 10) SEO ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<google_search_console_code>
